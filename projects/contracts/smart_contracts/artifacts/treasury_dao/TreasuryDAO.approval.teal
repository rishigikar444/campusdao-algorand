    concat
    // smart_contracts/treasury_dao/contract.py:168
    // vote_val, already_voted = self.has_voted.maybe(vote_key)
    pushbytes "hv"
    swap
    concat
    dup
    box_get
    bury 1
    // smart_contracts/treasury_dao/contract.py:169
    // assert not already_voted, "Already voted on this proposal"
    !
    assert // Already voted on this proposal
    // smart_contracts/treasury_dao/contract.py:171-172
    // # Check deadline not passed
    // assert Global.round <= self.proposal_deadline[proposal_id], "Voting period has ended"
    global Round
    bytec 7 // "pd"
    uncover 3
    concat
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_deadline entry exists
    <=
    assert // Voting period has ended
    // smart_contracts/treasury_dao/contract.py:174-175
    // # Record vote
    // self.has_voted[vote_key] = UInt64(1)
    intc_0 // 1
    itob
    box_put
    // smart_contracts/treasury_dao/contract.py:177
    // if support == UInt64(1):
    frame_dig -1
    intc_0 // 1
    ==
    bz vote_else_body@2
    // smart_contracts/treasury_dao/contract.py:178
    // self.proposal_votes_for[proposal_id] = self.proposal_votes_for[proposal_id] + UInt64(1)
    bytec 5 // "pf"
    swap
    concat
    dup
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_votes_for entry exists
    intc_0 // 1
    +
    itob
    box_put
    retsub

vote_else_body@2:
    // smart_contracts/treasury_dao/contract.py:180
    // self.proposal_votes_against[proposal_id] = self.proposal_votes_against[proposal_id] + UInt64(1)
    bytec 6 // "pg"
    swap
    concat
    dup
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_votes_against entry exists
    intc_0 // 1
    +
    itob
    box_put
    retsub


// smart_contracts.treasury_dao.contract.TreasuryDAO.execute_proposal(proposal_id: uint64) -> void:
execute_proposal:
    // smart_contracts/treasury_dao/contract.py:182-183
    // @abimethod()
    // def execute_proposal(self, proposal_id: UInt64) -> None:
    proto 1 0
    // smart_contracts/treasury_dao/contract.py:186
    // club_id = self.proposal_club[proposal_id]
    frame_dig -1
    itob
    bytec 4 // "pc"
    dig 1
    concat
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_club entry exists
    // smart_contracts/treasury_dao/contract.py:188-189
    // # Must not already be executed
    // assert self.proposal_executed[proposal_id] == UInt64(0), "Proposal already executed"
    bytec 12 // "pe"
    dig 2
    concat
    dup
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_executed entry exists
    !
    assert // Proposal already executed
    // smart_contracts/treasury_dao/contract.py:191-192
    // # Deadline must have passed
    // assert Global.round > self.proposal_deadline[proposal_id], "Voting period not over"
    global Round
    bytec 7 // "pd"
    dig 4
    concat
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_deadline entry exists
    >
    assert // Voting period not over
    // smart_contracts/treasury_dao/contract.py:194-195
    // # Quorum check: votes_for >= quorum
    // quorum = self.club_quorum[club_id]
    swap
    itob
    bytec 13 // "cq"
    dig 1
    concat
    box_get
    swap
    btoi
    swap
    assert // check self.club_quorum entry exists
    // smart_contracts/treasury_dao/contract.py:196
    // assert self.proposal_votes_for[proposal_id] >= quorum, "Quorum not reached"
    bytec 5 // "pf"
    dig 4
    concat
    dup
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_votes_for entry exists
    uncover 2
    >=
    assert // Quorum not reached
    // smart_contracts/treasury_dao/contract.py:198-199
    // # Must have more for than against
    // assert self.proposal_votes_for[proposal_id] > self.proposal_votes_against[proposal_id], "Proposal not approved"
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_votes_for entry exists
    bytec 6 // "pg"
    dig 4
    concat
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_votes_against entry exists
    >
    assert // Proposal not approved
    // smart_contracts/treasury_dao/contract.py:201-202
    // # Check treasury has enough
    // amount = self.proposal_amount[proposal_id]
    bytec 11 // "pa"
    dig 3
    concat
    box_get
    swap
    btoi
    swap
    assert // check self.proposal_amount entry exists
    // smart_contracts/treasury_dao/contract.py:203
    // treasury = self.club_treasury[club_id]
    bytec_2 // "ct"
    uncover 2
    concat
    dup
    box_get
    swap
    btoi
    swap
    assert // check self.club_treasury entry exists
    // smart_contracts/treasury_dao/contract.py:204
    // assert treasury >= amount, "Insufficient treasury balance"
    dup
    dig 3
    >=
    assert // Insufficient treasury balance
    // smart_contracts/treasury_dao/contract.py:206-207
    // # Execute payment
    // recipient = self.proposal_recipient[proposal_id]
    bytec 14 // "pr"
    uncover 5
    concat
    box_get
    assert // check self.proposal_recipient entry exists
    // smart_contracts/treasury_dao/contract.py:208
    // itxn.Payment(receiver=recipient, amount=amount, fee=0).submit()
    itxn_begin
    dig 3
    itxn_field Amount
    itxn_field Receiver
    intc_0 // pay
    itxn_field TypeEnum
    intc_1 // 0
    itxn_field Fee
    itxn_submit
    // smart_contracts/treasury_dao/contract.py:210-211
    // # Update state
    // self.club_treasury[club_id] = treasury - amount
    uncover 2
    -
    itob
    box_put
    // smart_contracts/treasury_dao/contract.py:212
    // self.proposal_executed[proposal_id] = UInt64(1)
    intc_0 // 1
    itob
    box_put
    retsub


